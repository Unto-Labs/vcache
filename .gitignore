# Build output
/build/
/bin/

# Downloaded third-party sources. gperftools is fetched by third-party/fetch.sh;
# the full Boost tree is scratch space for regen-boost-subset.sh. The minimal
# Boost subset in third-party/boost/ *is* committed.
/third-party/.dl/
/third-party/boost-full-*/
/third-party/gperftools

*.o
*.d
*.a

# vcpp builds against GCC's libcpp, which is fetched by vcpp/fetch-libcpp.sh
# rather than vendored -- keeping 58k lines of GPLv3 out of an Apache-2.0 tree.
/vcpp/.dl/
/vcpp/gcc-*/
/vcpp/build/
/vcpp/bin/
